{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "millebornes",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev"],
			"port": 5173
		},
		{
			"comment": "Serves the build AND the Netlify functions, so /api/* works and the service worker registers. Needed for anything touching push.",
			"name": "millebornes-netlify",
			"runtimeExecutable": "npx",
			"runtimeArgs": ["netlify", "serve", "--port", "8899"],
			"port": 8899
		},
		{
			"name": "millebornes-prod",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "preview", "--", "--port", "4173"],
			"port": 4173
		},
		{
			"name": "millebornes-dev-alt",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev", "--", "--port", "5191"],
			"port": 5191
		}
	]
}
